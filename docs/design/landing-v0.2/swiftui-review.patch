+/// Static art direction samples. No persistence, history projection, or progression rules.
+struct LandingFieldReview: View {
+    struct Countdown {
+        let days: Int
+        let fraction: Double
+    }
+
+    struct Row {
+        let color: Color
+        let ink: Color
+        let countdown: Countdown?
+    }
+
+    private static let doLevels = [0xD5D6D3, 0xB5C9AD, 0x90BB91, 0x66A879, 0x408C63, 0x24764D]
+    private static let avoidLevels = [0xA64E4E, 0xC47861, 0xD3A078, 0xB6B38B, 0x8CAE8A, 0x669E80]
+    private let showsTypeIndicators: Bool
+    private let day = CivilDay(containing: Date())
+    private let items: [DoAvoidItem]
+    private let rows: [UUID: Row]
+
+    init(showsTypeIndicators: Bool) {
+        self.showsTypeIndicators = showsTypeIndicators
+        let samples: [(String, DoAvoidKind, Int, Countdown?)] = [
+            ("Read ten pages", .doItem, 4, Countdown(days: 3, fraction: 0.72)),
+            ("Take a walk", .doItem, 3, nil),
+            ("Late caffeine", .avoidItem, 5, Countdown(days: 6, fraction: 0.42)),
+            ("Scroll in bed", .avoidItem, 2, nil),
+            ("Stretch", .doItem, 1, nil),
+        ]
+        let items = samples.map { DoAvoidItem(title: $0.0, kind: $0.1) }
+        self.items = items
+        rows = Dictionary(uniqueKeysWithValues: zip(items, samples).map { item, sample in
+            let palette = item.kind == .doItem ? Self.doLevels : Self.avoidLevels
+            let hex = palette[sample.2 - 1]
+            let color = Color(.sRGB, red: Double(hex >> 16) / 255,
+                              green: Double((hex >> 8) & 255) / 255, blue: Double(hex & 255) / 255)
+            return (item.id, Row(color: color, ink: Color(red: 0.07, green: 0.13, blue: 0.10), countdown: sample.3))
+        })
+    }
+
+    var body: some View {
+        FieldView(items: items, day: day, reviewRows: rows, showsTypeIndicators: showsTypeIndicators, onAdd: {}) { _ in }
+            .preferredColorScheme(.light)
+    }
+}
